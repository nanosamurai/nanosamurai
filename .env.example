# Copy to .env and adjust as needed. Do not commit real tokens.

COMPOSE_BIND_IP=127.0.0.1

# The default Nemotron and Parakeet models need no token. Set a least-privilege
# token with pyannote model access for the Whisper and Qwen overlays.
HF_TOKEN=

# Whisper overlay: realtime PARTIAL cadence. Lower values increase GPU work substantially.
RT_EMIT_EVERY_SEC=1.5

# Optional default ID per stage; each must be in that stage's BFF allowlist.
# Blank selects all realtime tracks and the first refined and final track.
SAMURAIBFF_DEFAULT_REALTIME_TRACK=
SAMURAIBFF_DEFAULT_REFINEMENT_TRACK=
SAMURAIBFF_DEFAULT_FINAL_TRACK=

# Optional sign-in with your own OIDC provider. Used only with
# docker-compose.sign-in.yml; see docs/authentication.md.
# SAMURAIBFF_AUTH_ISSUER=https://id.example.com/realms/acme
# SAMURAIBFF_AUTH_AUDIENCE=bff-web
# SAMURAIBFF_AUTH_CLIENT_ID=bff-web
# SAMURAIBFF_PUBLIC_ORIGIN_URI=http://localhost:8000
# Longest time a recording socket stays open (seconds, default 4 h).
# SAMURAIBFF_WS_MAX_DURATION_S=14400

# Compose owns the default GHCR pins. These optional overrides are for local
# development, evaluation of another immutable release, or rollback.
# KAFKA_IMAGE=apache/kafka:4.3.1
# S3_IMAGE=versity/versitygw:v1.10.0
# AWS_CLI_IMAGE=amazon/aws-cli:2.39.2
# LOCALSTACK_IMAGE=localstack/localstack:3.8.1
# SAMURAIBFF_IMAGE=ghcr.io/nanosamurai/samuraibff:sha-...
# SAMURAIPERSISTOR_IMAGE=ghcr.io/nanosamurai/samuraipersistor:sha-...
# RECORDER_WORKER_IMAGE=ghcr.io/nanosamurai/xamurai-recorder-worker:sha-...
# NEMOTRON_RTSERVICE_IMAGE=ghcr.io/nanosamurai/xamurai-nemotron-rtservice:sha-...
# PARAKEET_REFINEMENT_IMAGE=ghcr.io/nanosamurai/xamurai-parakeet-refinement:sha-...
# PARAKEET_FINALIZER_IMAGE=ghcr.io/nanosamurai/xamurai-parakeet-finalizer:sha-...
# RTSERVICE_IMAGE=ghcr.io/nanosamurai/xamurai-rtservice:sha-...
# WHISPERX_WORKER_IMAGE=ghcr.io/nanosamurai/xamurai-whisperx-worker:sha-...
# FINALIZER_WORKER_IMAGE=ghcr.io/nanosamurai/xamurai-finalizer-worker:sha-...
# QWEN_RTSERVICE_IMAGE=ghcr.io/nanosamurai/xamurai-qwen-rtservice:sha-...
# Optional Nemotron speaker labels (Sortformer) and enrolled-speaker names.
# NEMOTRON_DIARIZATION=true
# NEMOTRON_ENROLL_BACKEND=s3_manifest
# NEMOTRON_ENROLL_SIM_THRESHOLD=0.65
# NEMOTRON_ENROLL_MATCH_MARGIN=0.1
# DCGM_EXPORTER_IMAGE=nvidia/dcgm-exporter:4.5.2-4.8.1-ubuntu22.04

# Optional Qwen native-streaming evaluation settings. The peer realtime service
# remains internal to the Compose network and is added with docker-compose.qwen.yml.
# QWEN_STREAM_CHUNK_SECONDS=2.0
# QWEN_STREAM_EPOCH_SECONDS=60.0
# QWEN_EPOCH_CONTEXT_CHARACTERS=1000
# QWEN_MAX_NEW_TOKENS=1024
# QWEN_MAX_MODEL_LEN=4096
# QWEN_KV_CACHE_MIB=512

# Nemotron realtime. One internal replica admits one stream at a time.
# Each replica loads its own model copy into GPU memory.
# NEMOTRON_RTSERVICE_REPLICAS=1
# NEMOTRON_RT_SERVING_MAX_SESSIONS=1
# NEMOTRON_GPU=0
# Streaming right context in 80 ms encoder frames; the chunk is one frame more.
# 6 gives 560 ms chunks (default, most accurate here), 3 gives 320 ms, 1 gives 160 ms.
# NEMOTRON_RNNT_RIGHT_CONTEXT=6
